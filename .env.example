# Committed with empty values. To rebuild .env on a new machine, ask for one value per key.
# Each key holds a value that must never appear in this repo. Keys name nothing.
# API keys do not belong here.

# what: short name of a past or current client; add a key per written form | group: clients
CLIENT_A=
CLIENT_B=
CLIENT_C=
CLIENT_D=
CLIENT_E=

# what: name of a private repo the scanner was tried on; add a key per repo | group: repos
REPO_A=
REPO_B=
SLICE_A=

# what: SSH alias of a machine the maintainer works on, named after an ordinary word, so a hit warns | group: fleet | match: warn
DEPLOY_HOST_1=

# what: SSH alias of a machine the maintainer works on; add a key per machine | group: fleet
DEPLOY_HOST_2=
DEPLOY_HOST_3=
DEPLOY_HOST_4=
DEPLOY_HOST_5=

# what: an email address the maintainer commits or signs in with; add a key per address | group: people
ACCOUNT_EMAIL_A=
ACCOUNT_EMAIL_B=
